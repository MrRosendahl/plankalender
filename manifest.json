{
  "manifest_version": 3,
  "name": "FC Norrsken Plankalender",
  "version": "0.1.6",
  "description": "Filtrerar FC Norrskens kalender per anläggning och plan.",
  "content_scripts": [
    {
      "matches": ["https://www.fcnorrsken.se/kalender/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
