{
  "manifest_version": 3,
  "name": "FC Norrsken Bokningskalender",
  "short_name": "Bokningskalender",
  "version": "0.9.20",
  "description": "Visar FC Norrskens bokningar i en tidsmatris och upptäcker krockar mellan bokningsytor.",
  "author": "Michael Rosendahl",
  "homepage_url": "https://github.com/MrRosendahl/plankalender",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://www.fcnorrsken.se/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.fcnorrsken.se/kalender/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
